---
export const prerender = true;

import LegalLayout from '../components/legal/LegalLayout.astro';
import { LEGAL_UPDATED } from '../lib/legal';

/**
 * Cookiebeleid — en de reden dat er geen cookiebanner staat.
 *
 * De site zet geen trackingcookies. Wat er lokaal wordt opgeslagen zijn
 * functionele items in localStorage (mandje, verlanglijst) die je zelf
 * aanzet door iets toe te voegen. Voor die categorie is geen toestemming
 * vereist (art. 11.7a lid 3 Telecommunicatiewet).
 *
 * Elke regel hieronder is terug te vinden in de code: zie src/lib/cart.ts,
 * wishlist.ts, recent.ts en de sleutels in de PDP en Het Atelier.
 */

const stored = [
  { key: 'vh_cart_v1', what: 'Wat er in je winkelmandje ligt', why: 'Anders is je mandje weg zodra je een andere pagina opent', how: 'Tot je het mandje leegt' },
  { key: 'vh_wishlist', what: 'Je verlanglijst', why: 'Zodat je bewaarde stukken terugvindt', how: 'Tot je ze verwijdert' },
  { key: 'vh_recent', what: 'Onlangs bekeken stukken', why: 'Voor de rail "onlangs bekeken" op de productpagina', how: 'Laatste 8 stuks' },
  { key: 'vh_checkout_form_v1', what: 'Je ingevulde bezorggegevens', why: 'Zodat een refresh of een afgebroken betaling je formulier niet wist', how: 'Tot je de browsertab sluit' },
  { key: 'vh_atelier_claim', what: 'Je geclaimde nummer in Het Atelier', why: 'Om je certificaat terug te kunnen tonen', how: 'Tot je het wist' },
  { key: 'vh_backinstock', what: 'Aangevraagde voorraadmeldingen', why: 'Alleen als de aanvraag niet bij ons aankwam, als vangnet', how: 'Tot je het wist' },
];
---
<LegalLayout
  title="Cookiebeleid"
  heading="Cookies"
  headingAccent="en opslag"
  intro="Waarom je hier geen cookiebanner ziet, en wat we wél lokaal in je browser bewaren."
  description="Cookiebeleid van Villa Happ. Geen trackingcookies, geen advertentienetwerken, alleen functionele opslag in je eigen browser."
  updated={LEGAL_UPDATED}
>
  <section>
    <h2>Waarom er geen banner staat</h2>
    <p>
      Omdat er niets te vragen valt. We plaatsen geen trackingcookies, gebruiken
      geen advertentienetwerken en volgen je niet over websites heen. Voor
      opslag die strikt nodig is om de site te laten werken, is geen
      toestemming vereist. Een banner zou je dus alleen maar om iets vragen wat
      we niet doen.
    </p>
  </section>

  <section>
    <h2>Wat we wél bewaren</h2>
    <p>
      Een paar dingen slaan we lokaal op in je eigen browser, in de zogeheten
      localStorage. Die gegevens blijven op jouw apparaat en worden niet naar
      ons of naar derden gestuurd, behalve wanneer je zelf een bestelling
      plaatst.
    </p>
    <div class="vh-legal-tablewrap">
      <table class="vh-legal-table">
        <thead><tr><th>Naam</th><th>Wat</th><th>Waarom</th><th>Hoe lang</th></tr></thead>
        <tbody>
          {stored.map((s) => (
            <tr>
              <td><code>{s.key}</code></td>
              <td>{s.what}</td>
              <td>{s.why}</td>
              <td>{s.how}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      Wil je dit wissen, dan kan dat via de instellingen van je browser
      (websitegegevens verwijderen). Je verliest dan je mandje en je
      verlanglijst; verder werkt de site gewoon.
    </p>
  </section>

  <section>
    <h2>Bezoekstatistiek</h2>
    <p>
      We meten hoeveel mensen welke pagina bekijken met Vercel Web Analytics.
      Die dienst werkt zonder cookies en zonder een herkenbare bezoekers-ID: er
      wordt geen profiel opgebouwd en je bent tussen twee bezoeken niet als
      dezelfde persoon te herkennen. We zien dus wel dát een pagina bezocht is,
      maar niet door wie.
    </p>
  </section>

  <section>
    <h2>Betalen en adrescheck</h2>
    <p>
      Reken je af, dan ga je naar de betaalomgeving van Mollie. Wat Mollie daar
      plaatst valt onder hun eigen beleid. Vul je bij het afrekenen een
      Nederlandse postcode en huisnummer in, dan vraagt je browser rechtstreeks
      bij PDOK (Kadaster) de straat en plaats op; daar wordt geen cookie bij
      geplaatst. Meer daarover staat in onze
      <a href="/privacy">privacyverklaring</a>.
    </p>
  </section>

  <section>
    <h2>Wijzigingen</h2>
    <p>
      Gaan we ooit wél iets gebruiken waarvoor toestemming nodig is, dan komt er
      een keuzescherm en passen we deze pagina aan. Tot die tijd blijft het bij
      wat hierboven staat.
    </p>
  </section>
</LegalLayout>
